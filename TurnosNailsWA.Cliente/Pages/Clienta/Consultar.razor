@code {
    [SupplyParameterFromQuery]
    public string? Codigo { get; set; }

    private const string NumeroComercialWhatsApp = "5493513407604";

    private string codigoInput = "";
    private bool cargando = false;
    private string? mensajeError = null;
    private string? mensajeExito = null;
    private ReservaDetalleDTO? reserva = null;

    private string? tipoAccionCancelacion = null;
    private TurnoListadoDTO? turnoACancelar = null;
    private bool procesandoCancelacion = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Codigo))
        {
            codigoInput = Codigo.Trim();
            await BuscarReserva();
        }
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(codigoInput) && !cargando)
        {
            await BuscarReserva();
        }
    }

    private async Task BuscarReserva()
    {
        if (string.IsNullOrWhiteSpace(codigoInput))
        {
            return;
        }

        cargando = true;
        mensajeError = null;
        mensajeExito = null;
        reserva = null;
        CerrarConfirmacion();

        try
        {
            string codigoNormalizado = codigoInput.Trim().ToUpperInvariant();
            var resp = await http.GetAsync<ReservaDetalleDTO>($"api/reserva/codigo/{codigoNormalizado}");

            if (!resp.Error && resp.Respuesta != null)
            {
                reserva = resp.Respuesta;
            }
            else
            {
                mensajeError = !string.IsNullOrEmpty(resp.Mensaje)
                    ? resp.Mensaje
                    : $"No existe una reserva registrada con el código: {codigoNormalizado}.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Ocurrió un error al consultar la reserva: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private bool TurnoPuedeCancelar(TurnoListadoDTO t) =>
        reserva?.Estado == "Reserva Confirmada" &&
        t.Estado == "Turno confirmado" &&
        (t.Fecha.Date + t.Hora) > DateTime.Now;

    private bool PuedeCancelarReservaCompleta()
    {
        if (reserva?.Estado != "Reserva Confirmada" || reserva.Turnos == null)
        {
            return false;
        }

        var primerTurnoActivo = reserva.Turnos
            .Where(t => t.Estado != "Cancelado")
            .OrderBy(t => t.Fecha.Date + t.Hora)
            .FirstOrDefault();

        return primerTurnoActivo != null && (primerTurnoActivo.Fecha.Date + primerTurnoActivo.Hora) > DateTime.Now;
    }

    private void IniciarCancelacionTurno(TurnoListadoDTO turno)
    {
        tipoAccionCancelacion = "turno";
        turnoACancelar = turno;
        mensajeError = null;
        mensajeExito = null;
    }

    private void IniciarCancelacionReservaCompleta()
    {
        tipoAccionCancelacion = "reservaCompleta";
        turnoACancelar = null;
        mensajeError = null;
        mensajeExito = null;
    }

    private void CerrarConfirmacion()
    {
        tipoAccionCancelacion = null;
        turnoACancelar = null;
    }

    private async Task EjecutarCancelacion()
    {
        if (reserva == null || tipoAccionCancelacion == null)
        {
            return;
        }

        procesandoCancelacion = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            string url = tipoAccionCancelacion == "turno"
                ? $"api/turno/{turnoACancelar!.Id}/cancelar"
                : $"api/reserva/{reserva.Id}/cancelar";

            using var request = new HttpRequestMessage(HttpMethod.Put, url);
            request.Headers.Add("X-Codigo-Reserva", reserva.CodigoReserva);

            var respuesta = await httpClient.SendAsync(request);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito = tipoAccionCancelacion == "turno"
                    ? $"El turno de {turnoACancelar!.ServicioCompleto} fue cancelado exitosamente."
                    : "La reserva completa fue cancelada exitosamente.";

                CerrarConfirmacion();
                await RefrescarReserva();
            }
            else
            {
                var errorServidor = await HttpResp<bool>.LeerMensajeAsync(respuesta);
                mensajeError = !string.IsNullOrEmpty(errorServidor)
                    ? errorServidor
                    : "No se pudo realizar la cancelación. Verificá los datos e intentá nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Ocurrió un error al procesar la cancelación: " + ex.Message;
        }
        finally
        {
            procesandoCancelacion = false;
        }
    }

    private async Task RefrescarReserva()
    {
        if (reserva == null) return;
        var resp = await http.GetAsync<ReservaDetalleDTO>($"api/reserva/codigo/{reserva.CodigoReserva}");
        if (!resp.Error && resp.Respuesta != null)
        {
            reserva = resp.Respuesta;
        }
    }

    private string GenerarEnlaceWhatsAppConsulta(ReservaDetalleDTO r)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("¡Hola Eli Beauty Care! 👋");
        sb.AppendLine($"Te consulto sobre mi reserva *{r.CodigoReserva}* a nombre de {r.Cliente.Nombre} {r.Cliente.Apellido}.");
        sb.AppendLine($"📌 *Estado:* {r.Estado}");
        sb.AppendLine($"💰 *Total:* $ {r.ImporteTotal:N2} | *Saldo restante:* $ {((r.Liquidacion?.SaldoPendiente ?? (r.ImporteTotal - (r.Pago?.Monto ?? (r.ImporteTotal * 0.30m)))).ToString("N2"))}");

        string textoCodificado = Uri.EscapeDataString(sb.ToString());
        string numeroDestino = TelefonoHelper.FormatoWhatsApp(NumeroComercialWhatsApp);

        return $"https://wa.me/{numeroDestino}?text={textoCodificado}";
    }

