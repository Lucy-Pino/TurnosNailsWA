                @if (!string.IsNullOrEmpty(mensajeClienta))
                {
                    <div class="alert @(clientaExiste ? "alert-success" : "alert-info") py-2 px-3 small mb-3">
                        @mensajeClienta
                    </div>
                }

                @if (busquedaClientaRealizada && string.IsNullOrEmpty(errorTelefono))
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">Nombre:</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Tu nombre"
                                   @bind="clienteNombre"
                                   disabled="@clientaExiste" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">Apellido:</label>
                            <input type="text"
                                   class="form-control"
