@page "/reservar"
@using TurnosNailsWA.Shared.DTO
@using TurnosNailsWA.Servicio.ServicioHTTP
@inject IHttpService http
@inject HttpClient httpClient
@inject NavigationManager navHttp
@inject IJSRuntime js

<PageTitle>Reservar Turno • Eli Beauty Care</PageTitle>

<div class="container py-4">
    @if (reservaRegistrada != null)
    {
        <!-- PANTALLA DE CONFIRMACIÓN DE RESERVA EXITOSA (STITCH SCREEN 6) -->
        <div class="max-w-4xl mx-auto">
            <!-- Header Status -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 64px; height: 64px; background-color: var(--color-secondary-container); color: var(--color-primary);">
                    <span class="material-symbols-outlined fs-2">hourglass_top</span>
                </div>
                <h1 class="h2 fw-bold text-primary mb-2" style="font-family: 'Playfair Display', serif;">
                    ¡Solicitud de reserva recibida!
                </h1>
                <p class="text-muted mx-auto mb-3" style="max-width: 580px;">
                    Recibimos tu solicitud y el comprobante de transferencia adjunto. La reserva se encuentra <strong class="text-dark">en revisión</strong> hasta que verifiquemos el pago.
                </p>
                <!-- Badges de los 3 estados claramente visibles -->
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                    <span class="badge badge-stitch-warning px-3 py-1.5 rounded-pill fs-6">
                        Reserva: @reservaRegistrada.Estado
                    </span>
                    <span class="badge badge-stitch-warning px-3 py-1.5 rounded-pill fs-6">
                        Pago: @(reservaRegistrada.Pago?.Estado ?? "Pendiente de verificación")
                    </span>
                    <span class="badge badge-stitch-warning px-3 py-1.5 rounded-pill fs-6">
                        Turnos: Turno a confirmar
                    </span>
                </div>
            </div>

            <!-- Código Único de Reserva (High Emphasis Card) -->
            <div class="card card-stitch border-0 shadow-sm p-4 mb-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #fcf9f5 100%);">
                <div class="position-absolute top-0 start-0 end-0" style="height: 4px; background: linear-gradient(90deg, var(--color-primary), var(--color-primary-container));"></div>
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-8">
                        <span class="text-uppercase fw-semibold text-muted small d-flex align-items-center gap-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
                            <span class="material-symbols-outlined text-primary fs-6">tag</span> CÓDIGO ÚNICO DE RESERVA
                        </span>
                        <div class="display-6 fw-bold text-primary font-monospace my-1">
                            @reservaRegistrada.CodigoReserva
                        </div>
                        <p class="small text-muted mb-0">
                            <strong>Guardá tu código de reserva.</strong> Lo vas a necesitar para consultar tus turnos y el estado de tu reserva posteriormente.
                        </p>
                    </div>
                    <div class="col-12 col-md-4 text-md-end">
                        <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" @onclick="CopiarCodigo">
                            <span class="material-symbols-outlined fs-6">content_copy</span>
                            <span>@(codigoCopiado ? "¡Código copiado!" : "Copiar código")</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Two-column Summary: Client & Balance -->
            <div class="row g-4 mb-4">
                <!-- Client Details -->
                <div class="col-12 col-md-6">
                    <div class="card card-stitch h-100 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-light text-primary fw-bold" style="width: 48px; height: 48px;">
                                <span class="material-symbols-outlined fs-4">person</span>
                            </div>
                            <div>
                                <small class="text-uppercase text-muted fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Titular de la reserva</small>
                                <h5 class="mb-0 fw-bold">@reservaRegistrada.Cliente.Nombre @reservaRegistrada.Cliente.Apellido</h5>
                                <small class="text-muted d-flex align-items-center gap-1 mt-1">
                                    <span class="material-symbols-outlined fs-6">smartphone</span> @reservaRegistrada.Cliente.Telefono
                                </small>
                            </div>
                        </div>
                        <div class="pt-2 border-top small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Fecha de solicitud:</span>
                                <span class="fw-semibold text-dark">@reservaRegistrada.FechaCreacion.ToString("dd/MM/yyyy HH:mm") hs</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Estado de la reserva:</span>
                                <span class="badge badge-stitch-warning">@reservaRegistrada.Estado</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Estado del pago:</span>
                                <span class="badge badge-stitch-warning">@(reservaRegistrada.Pago?.Estado ?? "Pendiente de verificación")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Balance Financiero -->
                <div class="col-12 col-md-6">
                    <div class="card card-stitch h-100 p-4">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">payments</span>
                            Resumen Económico
                        </h6>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Total de la reserva:</span>
                            <span class="fw-bold fs-6 text-dark">$ @reservaRegistrada.ImporteTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Seña del 30%:</span>
                            <span class="fw-semibold text-dark">$ @((reservaRegistrada.ImporteTotal * 0.30m).ToString("N2"))</span>
                        </div>
                        <div class="p-2 rounded-3 mb-1 d-flex justify-content-between align-items-center" style="background-color: var(--color-surface-container-low);">
                            <span class="small fw-semibold text-primary d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined fs-6">check_circle</span> Importe transferido:
                            </span>
                            <span class="fw-bold text-primary">$ @((reservaRegistrada.Pago?.Monto ?? (reservaRegistrada.ImporteTotal * 0.30m)).ToString("N2"))</span>
                        </div>
                        <div class="p-2 rounded-3 mb-2 d-flex justify-content-between align-items-center" style="background-color: var(--color-surface-container);">
                            <span class="small text-muted">Restante a pagar en el salón (70%):</span>
                            <span class="fw-bold text-success">$ @((reservaRegistrada.ImporteTotal - (reservaRegistrada.Pago?.Monto ?? (reservaRegistrada.ImporteTotal * 0.30m))).ToString("N2"))</span>
                        </div>

                        @if (reservaRegistrada.Pago != null && !string.IsNullOrEmpty(reservaRegistrada.Pago.Comprobante))
                        {
                            <div class="pt-2 border-top">
                                <a href="api/pago/@reservaRegistrada.Pago.Id/comprobante" target="_blank" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined fs-6">receipt_long</span>
                                    <span>Ver comprobante adjuntado</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Aviso Importante de Verificación -->
            <div class="alert alert-warning py-2.5 px-3 small mb-4 d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-warning fs-5">info</span>
                <div>
                    <strong>Importante:</strong> Tu comprobante de transferencia bancaria fue recibido y está en proceso de verificación por la administradora. Cuando sea verificado, tu reserva y turnos quedarán confirmados.
                </div>
            </div>

            <!-- Tabla de turnos solicitados -->
            <div class="card card-stitch p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-primary fs-5">calendar_month</span>
                    Detalle de servicios y turnos solicitados
                </h6>
                <div class="table-responsive">
                    <table class="table table-stitch mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 90px;">Categoría</th>
                                <th>Servicio</th>
                                <th class="text-center">Duración</th>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Estado del turno</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var turno in reservaRegistrada.Turnos)
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="badge rounded-pill text-uppercase px-2 py-1" style="font-size: 0.7rem; background-color: @(turno.Categoria.Equals("Manos", StringComparison.OrdinalIgnoreCase) ? "var(--color-secondary-container)" : "#eae8e4"); color: var(--color-primary);">
                                            @turno.Categoria
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">@turno.ServicioNombre</td>
                                    <td class="text-center"><span class="badge badge-stitch-surface">@turno.Duracion min</span></td>
                                    <td>@turno.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@turno.Hora.ToString(@"hh\:mm") a @turno.HoraFin.ToString(@"hh\:mm") hs</td>
                                    <td class="text-end fw-bold text-dark">$ @turno.Precio.ToString("N2")</td>
                                    <td class="text-center"><span class="badge badge-stitch-warning">@turno.Estado</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sección de WhatsApp Comercial Oficial (5493513407604) -->
            <div class="card card-stitch p-4 mb-4">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center p-2.5" style="background-color: #e8f5e9; color: #2e7d32;">
                        <span class="material-symbols-outlined fs-3">chat</span>
                    </div>
                    <div>
                        <span class="text-uppercase fw-semibold text-success small" style="letter-spacing: 0.08em; font-size: 0.75rem;">Coordinación Directa</span>
                        <h4 class="h5 fw-bold text-dark mb-1">Avisale a Eli por WhatsApp</h4>
                        <p class="text-muted small mb-0">Podés agilizar la verificación enviándole una notificación directa con el detalle de tu reserva listo para enviar.</p>
                    </div>
                </div>

                <!-- Preview del mensaje preparado -->
                <div class="p-3 rounded-3 mb-3 small" style="background-color: var(--color-surface-container-low); border-left: 3px solid var(--color-primary);">
                    <div class="fw-bold text-muted small text-uppercase mb-1">Vista previa del mensaje pre-redactado:</div>
                    <div class="text-muted fst-italic">
                        “¡Hola Eli Beauty Care! 👋 Te comparto los datos de mi solicitud de reserva: Código único: <strong>@reservaRegistrada.CodigoReserva</strong>...”
                    </div>
                </div>

                <!-- Aclaración obligatoria de envío manual -->
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-primary fs-5">info</span>
                    <div>
                        <strong>Importante:</strong> El mensaje <em>no se envía automáticamente</em>. Al hacer clic en el botón a continuación, se abrirá WhatsApp en tu teléfono o computadora con los datos redactados para que vos presiones <strong>"Enviar"</strong> manualmente a Eli.
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex flex-wrap gap-2">
                    <a href="@GenerarEnlaceWhatsApp(reservaRegistrada)" target="_blank" rel="noopener noreferrer" class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-whatsapp fs-5"></i>
                        <span>Contactar por WhatsApp</span>
                    </a>
                    <a href="/consultar?codigo=@reservaRegistrada.CodigoReserva" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
                        <span class="material-symbols-outlined fs-5">search</span>
                        <span>Ver mi reserva en Consulta</span>
                    </a>
                    <button class="btn btn-stitch-secondary" @onclick="ReiniciarFormulario">
                        Hacer otra reserva
                    </button>
                    <a href="/" class="btn btn-link text-muted">Volver al Inicio</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Stepper Visual de Cuatro Pasos (Stitch Atelier Design) -->
        <div class="stitch-stepper-container">
            <ol class="stitch-stepper-list">
                <!-- Paso 1: Servicios -->
                <li class="stitch-step-item @(itemsSeleccionados.Count > 0 ? "completed" : "active")">
                    <div class="step-circle-wrapper">
                        <span class="step-circle">
                            @if (itemsSeleccionados.Count > 0)
                            {
                                <span class="material-symbols-outlined step-check-icon">check</span>
                            }
                            else
                            {
                                <span>1</span>
                            }
                        </span>
                        <span class="step-title">1. Servicios</span>
                    </div>
                </li>

                <li class="stitch-step-line @(itemsSeleccionados.Count > 0 ? "filled" : "")"></li>

                <!-- Paso 2: Fecha y Hora -->
                <li class="stitch-step-item @(TodosLosTurnosTienenHorario ? "completed" : (itemsSeleccionados.Count > 0 ? "active" : "pending"))">
                    <div class="step-circle-wrapper">
                        <span class="step-circle">
                            @if (TodosLosTurnosTienenHorario)
                            {
                                <span class="material-symbols-outlined step-check-icon">check</span>
                            }
                            else
                            {
                                <span>2</span>
                            }
                        </span>
                        <span class="step-title">2. Fecha y hora</span>
                    </div>
                </li>

                <li class="stitch-step-line @(TodosLosTurnosTienenHorario ? "filled" : "")"></li>

                <!-- Paso 3: Tus Datos -->
                <li class="stitch-step-item @(DatosClientaCompletos ? "completed" : (TodosLosTurnosTienenHorario ? "active" : "pending"))">
                    <div class="step-circle-wrapper">
                        <span class="step-circle">
                            @if (DatosClientaCompletos)
                            {
                                <span class="material-symbols-outlined step-check-icon">check</span>
                            }
                            else
                            {
                                <span>3</span>
                            }
                        </span>
                        <span class="step-title">3. Tus datos</span>
                    </div>
                </li>

                <li class="stitch-step-line @(DatosClientaCompletos ? "filled" : "")"></li>

                <!-- Paso 4: Seña del 30% -->
                <li class="stitch-step-item @(DatosClientaCompletos ? "active" : "pending")">
                    <div class="step-circle-wrapper">
                        <span class="step-circle">
                            <span>4</span>
                        </span>
                        <span class="step-title">4. Seña del 30%</span>
                    </div>
                </li>
            </ol>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined fs-5">error</span>
                    <div><strong>Atención:</strong> @mensajeError</div>
                </div>
                <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
            </div>
        }

        <!-- 1. SELECCIÓN DE SERVICIOS (STITCH SCREEN 2) -->
        <div class="card card-stitch p-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <span class="text-uppercase fw-semibold text-primary small d-block mb-1" style="letter-spacing: 0.1em; font-size: 0.75rem;">Paso 1 de 4 • Catálogo Atelier</span>
                    <h3 class="h4 fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">Seleccioná tus servicios</h3>
                    <p class="text-muted small mb-0">Podés elegir uno o varios servicios de Manos y Pies (incluso el mismo servicio varias veces):</p>
                </div>
                <!-- Filtros de categoría tipo pill de Stitch -->
                <div class="stitch-filter-group" id="categoryFilter">
                    <button type="button"
                            class="stitch-pill-btn @(filtroCategoria == "TODOS" ? "active" : "")"
                            @onclick='() => filtroCategoria = "TODOS"'>
                        <span>Todos</span>
                        <span class="stitch-pill-badge">@(serviciosDisponibles?.Count ?? 0)</span>
                    </button>
                    <button type="button"
                            class="stitch-pill-btn @(filtroCategoria == "MANOS" ? "active" : "")"
                            @onclick='() => filtroCategoria = "MANOS"'>
                        <span>Manos</span>
                        <span class="stitch-pill-badge">@(serviciosDisponibles?.Count(s => s.Categoria.Equals("Manos", StringComparison.OrdinalIgnoreCase)) ?? 0)</span>
                    </button>
                    <button type="button"
                            class="stitch-pill-btn @(filtroCategoria == "PIES" ? "active" : "")"
                            @onclick='() => filtroCategoria = "PIES"'>
                        <span>Pies</span>
                        <span class="stitch-pill-badge">@(serviciosDisponibles?.Count(s => s.Categoria.Equals("Pies", StringComparison.OrdinalIgnoreCase)) ?? 0)</span>
                    </button>
                </div>
            </div>

            @if (serviciosDisponibles == null)
            {
                <div class="d-flex align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary me-3" role="status"></div>
                    <span class="text-muted">Cargando catálogo de servicios del atelier...</span>
                </div>
            }
            else if (serviciosDisponibles.Count == 0)
            {
                <div class="alert alert-warning mb-0">No hay servicios disponibles en este momento.</div>
            }
            else
            {
                var serviciosFiltrados = serviciosDisponibles.Where(s =>
                    filtroCategoria == "TODOS" || s.Categoria.Equals(filtroCategoria, StringComparison.OrdinalIgnoreCase)).ToList();

                <div class="row g-3">
                    @foreach (var servicio in serviciosFiltrados)
                    {
                        int cant = CantidadSeleccionada(servicio.Id);
                        bool seleccionado = cant > 0;

                        <div class="col-12 col-md-6 col-lg-6" @key="servicio.Id">
                            <div class="service-card-stitch @(seleccionado ? "is-selected" : "")">
                                <div>
                                    <!-- Header: Categoría & Indicador Seleccionado -->
                                    <div class="service-card-header">
                                        <span class="category-badge @(servicio.Categoria.Equals("Manos", StringComparison.OrdinalIgnoreCase) ? "category-manos" : "category-pies")">
                                            @servicio.Categoria
                                        </span>
                                        @if (seleccionado)
                                        {
                                            <div class="selected-pill">
                                                <span class="material-symbols-outlined check-icon">check_circle</span>
                                                <span>Seleccionado</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Título y Descripción -->
                                    <h4 class="service-card-title">@servicio.Nombre</h4>
                                    <p class="service-card-desc">@servicio.Descripcion</p>
                                </div>

                                <!-- Footer: Duración, Precio y Botón/Controles -->
                                <div class="service-card-footer">
                                    <div class="service-meta">
                                        <span class="duration-badge">
                                            <span class="material-symbols-outlined clock-icon">schedule</span>
                                            <span>@servicio.Duracion min</span>
                                        </span>
                                        <span class="service-price">$ @servicio.Precio.ToString("N2")</span>
                                    </div>

                                    @if (cant > 0)
                                    {
                                        <div class="service-selected-controls">
                                            <span class="selected-count-label">Cantidad: <strong>@cant</strong></span>
                                            <div class="counter-btn-group">
                                                <button type="button"
                                                        class="counter-btn counter-minus"
                                                        @onclick="() => QuitarUltimaInstancia(servicio.Id)"
                                                        title="Disminuir cantidad"
                                                        aria-label="Quitar uno">
                                                    <span class="material-symbols-outlined">remove</span>
                                                </button>
                                                <span class="counter-value">@cant</span>
                                                <button type="button"
                                                        class="counter-btn counter-plus"
                                                        @onclick="() => AgregarInstancia(servicio)"
                                                        title="Aumentar cantidad"
                                                        aria-label="Agregar otro">
                                                    <span class="material-symbols-outlined">add</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn-select-stitch"
                                                @onclick="() => AgregarInstancia(servicio)">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                                            <span>Seleccionar servicio</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 2. SELECCIÓN DE FECHA Y HORARIOS DISPONIBLES (STITCH SCREEN 3) -->
        @if (TieneServiciosSeleccionados)
        {
            <div class="card card-stitch p-4 mb-4">
                <div class="mb-3">
                    <span class="text-uppercase fw-semibold text-primary small d-block mb-1" style="letter-spacing: 0.1em; font-size: 0.75rem;">Paso 2 de 4</span>
                    <h3 class="h4 fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">Elegí fecha y horario disponible para cada turno</h3>
                    <p class="text-muted small mb-0">
                        Cada selección mantiene su propia fecha, duración y horario disponible. La agenda compartida trabaja en intervalos de 15 minutos y bloquea automáticamente los horarios ya elegidos para que ningún turno se superponga:
                    </p>
                </div>

                <div class="row g-3">
                    @for (int i = 0; i < itemsSeleccionados.Count; i++)
                    {
                        var item = itemsSeleccionados[i];
                        int numInstancia = itemsSeleccionados.Take(i + 1).Count(x => x.ServicioId == item.ServicioId);
                        int totalInstancias = itemsSeleccionados.Count(x => x.ServicioId == item.ServicioId);

                        <div class="col-12 col-lg-6" @key="item.InstanciaId">
                            <div class="card p-3 h-100 bg-white border shadow-sm">
                                <div class="d-flex justify-content-between align-items-start mb-2 pb-2 border-bottom">
                                    <div>
                                        <span class="badge rounded-pill px-2 py-0.5 text-uppercase small" style="background-color: var(--color-secondary-container); color: var(--color-primary); font-size: 0.7rem;">
                                            @item.Categoria
                                        </span>
                                        <h6 class="fw-bold text-dark mb-0 mt-1">
                                            @item.Nombre
                                            @if (totalInstancias > 1)
                                            {
                                                <span class="badge bg-secondary ms-1">#@numInstancia</span>
                                            }
                                        </h6>
                                        <small class="text-muted">Duración: @item.Duracion min • $ @item.Precio.ToString("N2")</small>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => QuitarInstancia(item)" title="Quitar este turno">&times;</button>
                                </div>

                                <!-- Fecha Individual -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Fecha del turno:</label>
                                    <input type="date"
                                           class="form-control form-control-sm"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           value="@item.Fecha.ToString("yyyy-MM-dd")"
                                           @onchange="(e) => CambiarFecha(item, e.Value?.ToString())" />
                                </div>

                                <!-- Horarios Disponibles -->
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-dark">Horario disponible (intervalos de 15 min):</label>
                                    @if (item.Cargando)
                                    {
                                        <div class="d-flex align-items-center py-2 text-muted small">
                                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                            <span>Consultando turnos libres para el @item.Fecha.ToString("dd/MM/yyyy")...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        var horarios = ObtenerHorariosDisponiblesFiltrados(item);
                                        if (horarios.Count == 0)
                                        {
                                            <div class="alert alert-warning py-1 px-2 small mb-0">
                                                No hay horarios disponibles sin superposición para el @item.Fecha.ToString("dd/MM/yyyy"). Probá con otra fecha u otro horario en los demás turnos.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-1.5" style="max-height: 140px; overflow-y: auto;">
                                                @foreach (var turno in horarios)
                                                {
                                                    bool isSelected = item.HoraSeleccionada.HasValue && item.HoraSeleccionada.Value == turno.Hora;
                                                    var finTurno = turno.Hora.Add(TimeSpan.FromMinutes(item.Duracion));
                                                    <button type="button"
                                                            class="slot-pill @(isSelected ? "active" : "")"
                                                            title="@turno.Hora.ToString(@"hh\:mm") a @finTurno.ToString(@"hh\:mm") hs (@item.Duracion min)"
                                                            @onclick="() => SeleccionarHora(item, turno.Hora.ToString())">
                                                        @turno.Hora.ToString(@"hh\:mm")
                                                    </button>
                                                }
                                            </div>
                                            @if (item.HoraSeleccionada.HasValue)
                                            {
                                                var fin = item.HoraSeleccionada.Value.Add(TimeSpan.FromMinutes(item.Duracion));
                                                <div class="mt-2 small text-success fw-semibold d-flex align-items-center gap-1">
                                                    <span class="material-symbols-outlined fs-6">check_circle</span>
                                                    Seleccionado: @item.HoraSeleccionada.Value.ToString(@"hh\:mm") a @fin.ToString(@"hh\:mm") hs (@item.Duracion min)
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 3. DATOS DE LA CLIENTA (STITCH SCREEN 4) -->
        @if (TieneServiciosSeleccionados && TodosLosTurnosTienenHorario)
        {
            <div class="card card-stitch p-4 mb-4">
                <div class="mb-3">
                    <span class="text-uppercase fw-semibold text-primary small d-block mb-1" style="letter-spacing: 0.1em; font-size: 0.75rem;">Paso 3 de 4</span>
                    <h3 class="h4 fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">Datos de contacto de la clienta</h3>
                    <p class="text-muted small mb-0">Ingresá tu teléfono para identificarte (formato argentino de 10 dígitos, sin 0 ni 15). Si ya te atendiste con nosotros, completaremos tus datos automáticamente:</p>
                </div>

                <div class="row g-2 align-items-end mb-3">
