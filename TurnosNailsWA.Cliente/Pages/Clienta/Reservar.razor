                    @if (clientaExiste)
                    {
                        <small class="text-muted mt-2 d-block">Clienta registrada en el sistema.</small>
                    }
                }
            </div>
        }

        <!-- 4. REVISIÓN DE RESERVA, SEÑA 30% Y COMPROBANTE (STITCH SCREEN 5) -->
        @if (TieneServiciosSeleccionados && TodosLosTurnosTienenHorario && DatosClientaCompletos)
        {
            <div class="card card-stitch p-4 mb-4">
                <div class="mb-4">
                    <span class="text-uppercase fw-semibold text-primary small d-block mb-1" style="letter-spacing: 0.1em; font-size: 0.75rem;">Paso 4 de 4 • Confirmación Final</span>
