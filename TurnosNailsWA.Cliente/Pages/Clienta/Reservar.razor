                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: File upload and submit -->
                    <div class="col-12 col-lg-6">
                        <div class="card p-4 h-100 border d-flex flex-column justify-content-between" style="border-radius: 16px;">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-danger">Obligatorio</span>
                                    <h6 class="fw-bold mb-0 text-dark">Adjuntar comprobante de transferencia bancaria</h6>
                                </div>
                                <p class="small text-muted mb-3">
                                    Subí la captura de pantalla o recibo de tu transferencia bancaria (formatos permitidos: JPG, PNG o PDF, tamaño máx. 5 MB). Sin comprobante no es posible enviar la reserva.
                                </p>

                                <InputFile OnChange="OnArchivoSeleccionado" accept=".jpg,.jpeg,.png,.pdf" class="form-control mb-2" />

                                @if (!string.IsNullOrEmpty(errorArchivo))
                                {
