                @if (!string.IsNullOrEmpty(errorTelefono))
                {
                    <div class="text-danger small mb-3 d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined fs-6">warning</span>
                        <span>@errorTelefono</span>
