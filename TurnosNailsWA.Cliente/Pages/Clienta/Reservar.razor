                            <div class="p-3 rounded-3 bg-white border mb-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.7rem;">Monto exacto de seña (30%)</small>
                                    <span class="h4 fw-bold text-primary mb-0">$ @MontoAdelanto.ToString("N2")</span>
                                </div>
                                <span class="badge badge-stitch-primary">
                                    <span class="material-symbols-outlined fs-6 align-middle me-1">lock</span>
                                    Bloquea tu horario
