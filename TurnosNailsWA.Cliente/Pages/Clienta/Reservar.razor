</div>

@code {
    public class ServicioSeleccionadoItem
    {
        public Guid InstanciaId { get; set; } = Guid.NewGuid();
        public int ServicioId { get; set; }
        public string Nombre { get; set; } = "";
        public string Categoria { get; set; } = "";
        public int Duracion { get; set; }
        public decimal Precio { get; set; }
        public DateTime Fecha { get; set; } = DateTime.Today;
        public TimeSpan? HoraSeleccionada { get; set; }
        public List<TurnoDTO> HorariosDisponiblesBase { get; set; } = new();
        public DateTime? FechaConsultada { get; set; }
        public bool Cargando { get; set; }
        public string? ErrorCarga { get; set; }
    }

    private const string NumeroComercialWhatsApp = "5493513407604";

    private List<ServicioListadoDTO>? serviciosDisponibles;
    private List<ServicioSeleccionadoItem> itemsSeleccionados = new();
    private string filtroCategoria = "TODOS";

    // Clienta
    private string telefonoInput = "";
    private string? errorTelefono = null;
    private bool busquedaClientaRealizada = false;
    private bool clientaExiste = false;
    private int clienteId = 0;
    private string clienteNombre = "";
    private string clienteApellido = "";
    private string mensajeClienta = "";

    // Comprobante
    private IBrowserFile? archivoComprobante = null;
    private string? errorArchivo = null;

    // Estado general
    private string? mensajeError = null;
    private bool enviando = false;
    private ReservaDetalleDTO? reservaRegistrada = null;
    private bool codigoCopiado = false;

    private readonly List<string> CategoriasDisponibles = new() { "Manos", "Pies" };

    protected override async Task OnInitializedAsync()
    {
        await CargarServicios();
    }

    private async Task CargarServicios()
    {
        var resp = await http.GetAsync<List<ServicioListadoDTO>>("api/servicio");
        if (!resp.Error && resp.Respuesta != null)
        {
            serviciosDisponibles = resp.Respuesta;
        }
        else
        {
            serviciosDisponibles = new List<ServicioListadoDTO>();
            mensajeError = resp.Mensaje ?? "No se pudieron cargar los servicios.";
        }
    }

    private int CantidadSeleccionada(int servicioId) =>
        itemsSeleccionados.Count(x => x.ServicioId == servicioId);

    private bool TieneServiciosSeleccionados =>
        itemsSeleccionados.Count > 0;

    private decimal ImporteTotal =>
        itemsSeleccionados.Sum(s => s.Precio);

    private decimal MontoAdelanto =>
        Math.Round(ImporteTotal * 0.30m, 2);

    private bool TodosLosTurnosTienenHorario =>
        TieneServiciosSeleccionados &&
        itemsSeleccionados.All(s => s.HoraSeleccionada.HasValue);

    private bool DatosClientaCompletos =>
        busquedaClientaRealizada &&
        string.IsNullOrEmpty(errorTelefono) &&
        TelefonoHelper.ValidarYNormalizar(telefonoInput, out _, out _) &&
        !string.IsNullOrWhiteSpace(clienteNombre) &&
        !string.IsNullOrWhiteSpace(clienteApellido);

    private bool PuedeEnviar =>
        TieneServiciosSeleccionados &&
        TodosLosTurnosTienenHorario &&
        DatosClientaCompletos &&
        archivoComprobante != null;

    private async Task AgregarInstancia(ServicioListadoDTO servicio)
    {
        var nuevoItem = new ServicioSeleccionadoItem
        {
            InstanciaId = Guid.NewGuid(),
            ServicioId = servicio.Id,
            Nombre = servicio.Nombre,
            Categoria = servicio.Categoria,
            Duracion = servicio.Duracion,
            Precio = servicio.Precio,
            Fecha = DateTime.Today,
            HoraSeleccionada = null,
            Cargando = true
        };
        itemsSeleccionados.Add(nuevoItem);

        await ConsultarDisponibilidadServicio(nuevoItem);
    }

    private void QuitarInstancia(ServicioSeleccionadoItem item)
    {
        itemsSeleccionados.Remove(item);
        RecalcularSuperposiciones(item.InstanciaId);
    }

    private void QuitarUltimaInstancia(int servicioId)
    {
        var ultimo = itemsSeleccionados.LastOrDefault(x => x.ServicioId == servicioId);
        if (ultimo != null)
        {
            itemsSeleccionados.Remove(ultimo);
            RecalcularSuperposiciones(ultimo.InstanciaId);
        }
    }

    private async Task CambiarFecha(ServicioSeleccionadoItem item, string? valorFecha)
    {
        if (DateTime.TryParse(valorFecha, out var nuevaFecha))
        {
            if (nuevaFecha.Date < DateTime.Today)
            {
                nuevaFecha = DateTime.Today;
            }

            if (item.Fecha.Date != nuevaFecha.Date)
            {
                item.Fecha = nuevaFecha.Date;
                item.HoraSeleccionada = null;
                item.HorariosDisponiblesBase.Clear();
                item.FechaConsultada = null;

                RecalcularSuperposiciones(item.InstanciaId);
                await ConsultarDisponibilidadServicio(item);
            }
        }
    }

    private void SeleccionarHora(ServicioSeleccionadoItem item, string? horaStr)
    {
        if (TimeSpan.TryParse(horaStr, out var hora))
        {
            item.HoraSeleccionada = hora;
        }
        else
        {
            item.HoraSeleccionada = null;
        }

        RecalcularSuperposiciones(item.InstanciaId);
    }

    private async Task ConsultarDisponibilidadServicio(ServicioSeleccionadoItem item)
    {
        var fechaConsulta = item.Fecha.Date;
        item.Cargando = true;
        item.ErrorCarga = null;
        item.HorariosDisponiblesBase.Clear();
        item.FechaConsultada = null;

        try
        {
            var url = $"api/turno/disponibilidad?fecha={fechaConsulta:yyyy-MM-dd}&servicioId={item.ServicioId}";
            var resp = await http.GetAsync<List<TurnoDTO>>(url);

            if (item.Fecha.Date == fechaConsulta)
            {
                if (!resp.Error && resp.Respuesta != null)
                {
                    item.HorariosDisponiblesBase = resp.Respuesta
                        .Where(t => t.Fecha.Date == fechaConsulta)
                        .ToList();
                    item.FechaConsultada = fechaConsulta;
                }
                else
                {
                    item.HorariosDisponiblesBase = new List<TurnoDTO>();
                    item.FechaConsultada = fechaConsulta;
                }
            }
        }
        catch (Exception ex)
        {
            if (item.Fecha.Date == fechaConsulta)
            {
                item.HorariosDisponiblesBase = new List<TurnoDTO>();
                item.FechaConsultada = fechaConsulta;
                item.ErrorCarga = ex.Message;
            }
        }
        finally
        {
            if (item.Fecha.Date == fechaConsulta)
            {
                item.Cargando = false;
            }
        }

        ValidarHoraSeleccionada(item);
        RecalcularSuperposiciones(item.InstanciaId);
        StateHasChanged();
    }

    private List<TurnoDTO> ObtenerHorariosDisponiblesFiltrados(ServicioSeleccionadoItem itemActual)
    {
        if (itemActual.FechaConsultada == null || itemActual.FechaConsultada.Value.Date != itemActual.Fecha.Date)
        {
            return new List<TurnoDTO>();
        }

        if (itemActual.HorariosDisponiblesBase == null || itemActual.HorariosDisponiblesBase.Count == 0)
        {
            return new List<TurnoDTO>();
        }

        var duracionActual = TimeSpan.FromMinutes(itemActual.Duracion);
        var intervalosOcupados = new List<(TimeSpan Inicio, TimeSpan Fin)>();

        foreach (var otro in itemsSeleccionados)
        {
            if (otro.InstanciaId == itemActual.InstanciaId)
            {
                continue;
            }

            if (otro.Fecha.Date == itemActual.Fecha.Date && otro.HoraSeleccionada.HasValue)
            {
                var inicioOtro = otro.HoraSeleccionada.Value;
                var finOtro = inicioOtro.Add(TimeSpan.FromMinutes(otro.Duracion));
                intervalosOcupados.Add((inicioOtro, finOtro));
            }
        }

        var horaCierre = new TimeSpan(15, 0, 0);
        var resultado = new List<TurnoDTO>();

        foreach (var candidato in itemActual.HorariosDisponiblesBase)
        {
            if (candidato.Fecha.Date != itemActual.Fecha.Date)
            {
                continue;
            }

            var inicioCandidato = candidato.Hora;
            var finCandidato = inicioCandidato + duracionActual;

            if (finCandidato > horaCierre)
            {
                continue;
            }

            bool colisiona = false;
            foreach (var ocupado in intervalosOcupados)
            {
                if (SeSuperpone(inicioCandidato, finCandidato, ocupado.Inicio, ocupado.Fin))
                {
                    colisiona = true;
                    break;
                }
            }

            if (!colisiona)
            {
                resultado.Add(candidato);
            }
        }

        return resultado;
    }

    private static bool SeSuperpone(TimeSpan inicioA, TimeSpan finA, TimeSpan inicioB, TimeSpan finB)
    {
        return inicioA < finB && inicioB < finA;
    }

    private void ValidarHoraSeleccionada(ServicioSeleccionadoItem item)
    {
        if (item.HoraSeleccionada.HasValue)
        {
            var disponibles = ObtenerHorariosDisponiblesFiltrados(item);
            if (!disponibles.Any(d => d.Hora == item.HoraSeleccionada.Value))
            {
                item.HoraSeleccionada = null;
            }
        }
    }

    private void RecalcularSuperposiciones(Guid instanciaIdModificada)
    {
        foreach (var otro in itemsSeleccionados)
        {
            if (otro.InstanciaId == instanciaIdModificada)
            {
                continue;
            }

            if (otro.HoraSeleccionada.HasValue)
            {
                var disponibles = ObtenerHorariosDisponiblesFiltrados(otro);
                if (!disponibles.Any(d => d.Hora == otro.HoraSeleccionada.Value))
                {
                    otro.HoraSeleccionada = null;
                }
            }
        }
    }

    private void OnTelefonoInputChanged(ChangeEventArgs e)
    {
        telefonoInput = e.Value?.ToString() ?? "";
        errorTelefono = null;
        mensajeClienta = "";

        if (!string.IsNullOrWhiteSpace(telefonoInput))
        {
            if (!TelefonoHelper.ValidarYNormalizar(telefonoInput, out _, out var err))
            {
                errorTelefono = err;
            }
        }
    }

    private async Task BuscarClienta()
    {
        mensajeClienta = "";
        errorTelefono = null;

        if (!TelefonoHelper.ValidarYNormalizar(telefonoInput, out var normalizado, out var err))
        {
            errorTelefono = err;
            mensajeClienta = err;
            clientaExiste = false;
            busquedaClientaRealizada = false;
            return;
        }

        telefonoInput = normalizado;
        var resp = await http.GetAsync<ClienteDTO>($"api/cliente/telefono/{normalizado}");
        busquedaClientaRealizada = true;

        if (!resp.Error && resp.Respuesta != null)
        {
            clienteId = resp.Respuesta.Id;
            clienteNombre = resp.Respuesta.Nombre;
            clienteApellido = resp.Respuesta.Apellido;
            clientaExiste = true;
            mensajeClienta = "¡Clienta registrada encontrada!";
        }
        else
        {
            clienteId = 0;
            clienteNombre = "";
            clienteApellido = "";
            clientaExiste = false;
            mensajeClienta = "No encontramos un registro previo con este teléfono. Por favor completá tu nombre y apellido para registrarte.";
        }
    }

    private void OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        errorArchivo = null;
        var archivo = e.File;
        if (archivo == null)
        {
            archivoComprobante = null;
            return;
        }

        if (archivo.Size > 5 * 1024 * 1024)
        {
            errorArchivo = "El comprobante no puede superar los 5 MB.";
            archivoComprobante = null;
            return;
        }

        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (extension != ".jpg" && extension != ".jpeg" && extension != ".png" && extension != ".pdf")
        {
            errorArchivo = "El comprobante debe ser un archivo JPG, JPEG, PNG o PDF.";
            archivoComprobante = null;
            return;
        }

        archivoComprobante = archivo;
    }

    private async Task EnviarReserva()
    {
        if (!PuedeEnviar)
        {
            return;
        }

        if (!TelefonoHelper.ValidarYNormalizar(telefonoInput, out var telefonoFinal, out var errorTel))
        {
            mensajeError = errorTel;
            errorTelefono = errorTel;
            return;
        }

        enviando = true;
        mensajeError = null;

        try
        {
            foreach (var item in itemsSeleccionados)
            {
                var respDispo = await http.GetAsync<List<TurnoDTO>>($"api/turno/disponibilidad?fecha={item.Fecha:yyyy-MM-dd}&servicioId={item.ServicioId}");
                if (respDispo.Error || respDispo.Respuesta == null)
                {
                    mensajeError = $"No se pudo verificar la disponibilidad del servicio '{item.Categoria.ToUpper()} – {item.Nombre}' para el {item.Fecha:dd/MM/yyyy}. Por favor intentá nuevamente.";
                    enviando = false;
                    return;
                }

                bool sigueDisponible = respDispo.Respuesta.Any(t => t.Fecha.Date == item.Fecha.Date && t.Hora == item.HoraSeleccionada!.Value);
                if (!sigueDisponible)
                {
                    mensajeError = $"El turno de las {item.HoraSeleccionada!.Value.ToString(@"hh\:mm")} hs para '{item.Categoria.ToUpper()} – {item.Nombre}' el {item.Fecha:dd/MM/yyyy} ya no está disponible. Por favor seleccioná otro horario.";
                    item.HorariosDisponiblesBase = respDispo.Respuesta.Where(t => t.Fecha.Date == item.Fecha.Date).ToList();
                    item.FechaConsultada = item.Fecha.Date;
                    item.HoraSeleccionada = null;
                    RecalcularSuperposiciones(item.InstanciaId);
                    enviando = false;
                    return;
                }
            }

            for (int i = 0; i < itemsSeleccionados.Count; i++)
            {
                var t1 = itemsSeleccionados[i];
                var fin1 = t1.HoraSeleccionada!.Value + TimeSpan.FromMinutes(t1.Duracion);

                for (int j = i + 1; j < itemsSeleccionados.Count; j++)
                {
                    var t2 = itemsSeleccionados[j];
                    if (t1.Fecha.Date == t2.Fecha.Date)
                    {
                        var fin2 = t2.HoraSeleccionada!.Value + TimeSpan.FromMinutes(t2.Duracion);
                        if (SeSuperpone(t1.HoraSeleccionada!.Value, fin1, t2.HoraSeleccionada!.Value, fin2))
                        {
                            mensajeError = $"Los turnos de '{t1.Categoria.ToUpper()} – {t1.Nombre}' y '{t2.Categoria.ToUpper()} – {t2.Nombre}' tienen horarios superpuestos el {t1.Fecha:dd/MM/yyyy}. Por favor seleccioná horarios diferentes.";
                            enviando = false;
                            return;
                        }
                    }
                }
            }

            if (clienteId == 0)
            {
                var nuevoCliente = new ClienteDTO
                {
                    Nombre = clienteNombre.Trim(),
                    Apellido = clienteApellido.Trim(),
                    Telefono = telefonoFinal
                };

                var respCliente = await http.PostAsync<ClienteDTO, int>("api/cliente", nuevoCliente);
                if (respCliente.Error || respCliente.Respuesta <= 0)
                {
                    mensajeError = respCliente.Mensaje ?? "No se pudo registrar la clienta. Verificá los datos ingresados.";
                    enviando = false;
                    return;
                }
                clienteId = respCliente.Respuesta;
            }

            using var formData = new MultipartFormDataContent();
            formData.Add(new StringContent(clienteId.ToString()), "ClienteId");

            int index = 0;
            foreach (var item in itemsSeleccionados)
            {
                formData.Add(new StringContent(item.ServicioId.ToString()), $"Turnos[{index}].ServicioId");
                formData.Add(new StringContent(item.Fecha.ToString("yyyy-MM-dd")), $"Turnos[{index}].Fecha");
                formData.Add(new StringContent(item.HoraSeleccionada!.Value.ToString(@"hh\:mm\:ss")), $"Turnos[{index}].Hora");
                index++;
            }

            var fileStream = archivoComprobante!.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var fileContent = new StreamContent(fileStream);
            if (!string.IsNullOrEmpty(archivoComprobante.ContentType))
            {
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivoComprobante.ContentType);
            }
            formData.Add(fileContent, "comprobante", archivoComprobante.Name);

            var respuestaHttp = await httpClient.PostAsync("api/reserva", formData);

            if (respuestaHttp.IsSuccessStatusCode)
            {
                reservaRegistrada = await respuestaHttp.Content.ReadFromJsonAsync<ReservaDetalleDTO>();
                codigoCopiado = false;
            }
            else
            {
                var errorServidor = await HttpResp<ReservaDetalleDTO>.LeerMensajeAsync(respuestaHttp);
                mensajeError = !string.IsNullOrEmpty(errorServidor)
                    ? errorServidor
                    : "No se pudo registrar la reserva. Verificá los datos e intentá nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Ocurrió un error al procesar la reserva: " + ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task CopiarCodigo()
    {
        if (reservaRegistrada == null) return;
        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", reservaRegistrada.CodigoReserva);
            codigoCopiado = true;
        }
        catch
        {
            codigoCopiado = true;
        }
    }

    private string GenerarEnlaceWhatsApp(ReservaDetalleDTO r)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("¡Hola Eli Beauty Care! 👋");
        sb.AppendLine("Te comparto los datos de mi solicitud de reserva:");
        sb.AppendLine();
        sb.AppendLine($"📋 *Código único:* {r.CodigoReserva}");
        sb.AppendLine($"👤 *Clienta:* {r.Cliente.Nombre} {r.Cliente.Apellido}");
        sb.AppendLine($"📱 *Teléfono:* {r.Cliente.Telefono}");
        sb.AppendLine($"📌 *Estado:* {r.Estado}");
        sb.AppendLine();
        sb.AppendLine("💅 *Servicios y Turnos:*");
        foreach (var t in r.Turnos)
        {
            sb.AppendLine($"• {t.ServicioCompleto} | {t.Fecha:dd/MM/yyyy} de {t.Hora:hh\\:mm} a {t.HoraFin:hh\\:mm} hs ({t.Duracion} min) - $ {t.Precio:N2}");
        }
        sb.AppendLine();
        sb.AppendLine("💰 *Resumen Económico:*");
        sb.AppendLine($"• Total de la reserva: $ {r.ImporteTotal:N2}");
        var senia = r.Pago?.Monto ?? Math.Round(r.ImporteTotal * 0.30m, 2);
        sb.AppendLine($"• Seña del 30%: $ {senia:N2}");
        sb.AppendLine($"• Importe transferido: $ {senia:N2}");
        var restante = r.ImporteTotal - senia;
        sb.AppendLine($"• Restante a pagar en el salón: $ {restante:N2}");
        sb.AppendLine();
        sb.AppendLine("Adjunté mi comprobante de transferencia bancaria para su verificación. ¡Muchas gracias!");

        string textoCodificado = Uri.EscapeDataString(sb.ToString());
        string numeroDestino = TelefonoHelper.FormatoWhatsApp(NumeroComercialWhatsApp);

        return $"https://wa.me/{numeroDestino}?text={textoCodificado}";
    }

    private void ReiniciarFormulario()
    {
        reservaRegistrada = null;
        codigoCopiado = false;
        itemsSeleccionados.Clear();
        archivoComprobante = null;
        errorArchivo = null;
        mensajeError = null;
        busquedaClientaRealizada = false;
        clientaExiste = false;
        clienteId = 0;
        clienteNombre = "";
        clienteApellido = "";
        telefonoInput = "";
        errorTelefono = null;
        mensajeClienta = "";
    }
}
