@page "/servicios"
@attribute [Authorize]
@using TurnosNailsWA.Shared.DTO
@using TurnosNailsWA.Servicio.ServicioHTTP
@inject IHttpService http

<PageTitle>Catálogo de Servicios • Eli Beauty Care</PageTitle>

<div class="container py-4">
    <!-- Header Area -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill text-uppercase small" style="background-color: var(--color-secondary-container); color: var(--color-primary); font-size: 0.72rem;">Consola Operativa</span>
                <span class="text-muted small">•</span>
                <span class="text-muted small">Catálogo del Atelier</span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">Catálogo de Servicios</h1>
            <p class="text-muted small mb-0">Servicios vigentes de manicura y pedicura, tiempos de sesión y tarifas del salón.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-info py-2 px-3 small mb-4">@mensaje</div>
    }

    @if (servicios == null)
    {
        <div class="d-flex align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span class="text-muted">Cargando catálogo de servicios...</span>
        </div>
    }
    else if (servicios.Count == 0)
    {
        <div class="card card-stitch p-4 text-center text-muted">
            No existen servicios registrados en el sistema.
        </div>
    }
    else
    {
        <div class="card card-stitch p-0 overflow-hidden mb-4 shadow-sm">
            <div class="table-responsive">
                <table class="table table-stitch mb-0">
                    <thead>
                        <tr>
                            <th>Categoría</th>
                            <th>Servicio</th>
                            <th>Descripción</th>
                            <th class="text-center">Duración</th>
                            <th class="text-end">Precio Vigente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servicio in servicios)
                        {
                            <tr>
                                <td>
                                    <span class="badge rounded-pill text-uppercase px-2.5 py-1" style="font-size: 0.7rem; background-color: @(servicio.Categoria.Equals("Manos", StringComparison.OrdinalIgnoreCase) ? "var(--color-secondary-container)" : "#eae8e4"); color: var(--color-primary);">
                                        @servicio.Categoria
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">@servicio.Categoria.ToUpper() – @servicio.Nombre</td>
                                <td class="text-muted small" style="max-width: 320px;">@servicio.Descripcion</td>
                                <td class="text-center">
                                    <span class="badge badge-stitch-surface">@servicio.Duracion min</span>
                                </td>
                                <td class="text-end fw-bold text-primary fs-6">$ @servicio.Precio.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<ServicioListadoDTO>? servicios;
    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await LeerServicios();
    }

    private async Task LeerServicios()
    {
        try
        {
            var resp = await http.GetAsync<List<ServicioListadoDTO>>("api/servicio");

            if (resp.Error)
            {
                if (resp.Response?.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    servicios = new List<ServicioListadoDTO>();
                }
                else
                {
                    mensaje = resp.Mensaje ?? "No se pudieron obtener los servicios.";
                }
            }
            else
            {
                servicios = resp.Respuesta ?? new List<ServicioListadoDTO>();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }
}
