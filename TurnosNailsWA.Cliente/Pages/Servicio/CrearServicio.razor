@page "/servicios/crear"
@using TurnosNailsWA.Servicio.ServicioHTTP
@using TurnosNailsWA.Shared.DTO

@inject IHttpService http
@inject NavigationManager navHttp

<h3>REGISTRAR UN SERVICIO</h3>

<EditForm Model="servicio" OnValidSubmit="Grabar" FormName="CrearServicioForm">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>
            Nombre del Servicio:
        </label>
        <div>
            <InputText class="form-control" @bind-Value="servicio.Nombre" />
            <ValidationMessage For="@(() => servicio.Nombre)" />
        </div>
    </div>
    <br />
    <div class="form-group">
        <label>
            Categoría:
        </label>
        <div>
            <InputText class="form-control" @bind-Value="servicio.Categoria" />
            <ValidationMessage For="@(() => servicio.Categoria)" />
        </div>
    </div>
    <br />
    <div class="form-group">
        <label>
            Descripción:
        </label>
        <div>
            <InputTextArea class="form-control" @bind-Value="servicio.Descripcion" />
            <ValidationMessage For="@(() => servicio.Descripcion)" />
        </div>
    </div>
    <br />
    <div class="form-group">
        <label>
            Duración (minutos):
        </label>
        <div>
            <InputNumber class="form-control" @bind-Value="servicio.Duracion" />
            <ValidationMessage For="@(() => servicio.Duracion)" />
        </div>
    </div>
    <br />
    <div class="form-group">
        <label>
            Precio:
        </label>
        <div>
            <InputNumber class="form-control" step="0.01" @bind-Value="servicio.Precio" />
            <ValidationMessage For="@(() => servicio.Precio)" />
        </div>
    </div>
    <br />
    <button class="btn btn-primary" type="submit">Grabar</button>
    <button class="btn btn-secondary" type="button" @onclick="Cancelar">Cancelar</button>
</EditForm>
<br />
<p>@Mensaje</p>


@code {
    private ServicioDTO servicio = new ServicioDTO();
    string Mensaje = "";

    private async Task Grabar()
    {
        var httpRespuesta = await http.PostAsync<ServicioDTO, int>("api/servicio", servicio);
        if (!httpRespuesta.Error)
        {
            navHttp.NavigateTo("/servicios?guardado=true");
        }
        else
        {
            Mensaje = httpRespuesta.Mensaje ?? "";
        }
    }

    private void Cancelar()
    {
        navHttp.NavigateTo("/servicios");
    }

}
