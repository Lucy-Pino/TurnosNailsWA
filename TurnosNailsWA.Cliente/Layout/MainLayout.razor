@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border px-2 py-1 small">
                    <span class="material-symbols-outlined text-primary fs-6 align-middle me-1">spa</span>
                    Atelier de Manicura &amp; Pedicura
                </span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="https://wa.me/5493513407604" target="_blank" class="d-none d-md-inline-flex align-items-center gap-1 text-success fw-semibold small">
                    <i class="bi bi-whatsapp"></i> WhatsApp Atelier
                </a>
                <AuthorizeView>
                    <Authorized>
                        <span class="badge bg-primary text-white px-2 py-1 small">
                            <span class="material-symbols-outlined fs-6 align-middle me-1">verified_user</span>
                            Admin: @context.User.Identity?.Name
                        </span>
                    </Authorized>
                    <NotAuthorized>
                        <a href="admin/login" class="text-secondary small fw-medium">
                            <span class="material-symbols-outlined fs-6 align-middle me-1">lock</span>
                            Acceso Privado
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4 pb-5">
            @Body
        </article>
    </main>
</div>
